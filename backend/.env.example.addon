
# ── Microsoft 365 OAuth2 (F1 — Login com Microsoft) ──────────────────────────
# Deixe em branco para desabilitar o botão "Entrar com Microsoft 365".
# Registre um App no Azure Portal → Authentication → Web Redirect URI:
#   https://SEU_BACKEND_DOMINIO/api/auth/microsoft/callback
# (FRONTEND_URL pode listar múltiplos domínios separados por vírgula;
#  o redirect URI usa apenas o PRIMEIRO valor.)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
# Use o tenant ID real da sua organização (ex.: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
# para restringir o login apenas a contas do seu diretório.
